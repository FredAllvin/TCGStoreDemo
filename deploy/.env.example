# Copy to the repo root as ".env" and fill in. Never commit the real .env.

# Domain the site runs on (DNS A record must point at this server)
SITE_DOMAIN=demo.example.com

# Profiles: "prod" for a client store, "prod,demo" for the public demo
# (demo adds: seeded placeholder catalog, demo ribbon, nightly reset)
SPRING_PROFILES=prod,demo

# Database (used by both the app and the postgres container)
POSTGRES_DB=tcgshop
POSTGRES_USER=tcgshop
POSTGRES_PASSWORD=change-me-to-something-long-and-random

# Admin account (created/updated at startup; demo profile overrides to demo/demo123).
# On a real (non-demo) prod store the app refuses to start unless ADMIN_PASSWORD is
# at least 12 characters and not a common/example value — generate a strong one,
# e.g.  openssl rand -base64 24
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Payments: "mock" (fake pay page) or "stripe"
PAYMENTS_PROVIDER=mock
# From https://dashboard.stripe.com/test/apikeys (sk_test_… for test mode)
STRIPE_SECRET_KEY=
# From the webhook endpoint you create in the Stripe dashboard (whsec_…)
STRIPE_WEBHOOK_SECRET=
